# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# MongoDB connection for marketplace workers, bookings, reviews, and complaints
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=labrkp

# MySQL database used by Drizzle ORM for user accounts
DATABASE_URL=mysql://<username>:<password>@<host>:3306/<database>

# -----------------------------------------------------------------------------
# Authentication & Security
# -----------------------------------------------------------------------------
# Secret key used for signing session JWTs (minimum 32 characters in production)
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key

# Local Administrator Credentials
ADMIN_EMAIL=admin@labrkp.pk
ADMIN_PASSWORD=replace_with_strong_admin_password

# -----------------------------------------------------------------------------
# Marketplace & Payments
# -----------------------------------------------------------------------------
PLATFORM_COMMISSION_RATE=3

# Easypaisa Payment Gateway (Optional/Sandbox)
EASYPAISA_MERCHANT_ID=
EASYPAISA_SECRET=
EASYPAISA_PAYMENT_URL=

# JazzCash Payment Gateway (Optional/Sandbox)
JAZZCASH_MERCHANT_ID=
JAZZCASH_SECRET=
JAZZCASH_PAYMENT_URL=

PAYMENT_RETURN_URL=http://localhost:3000/track
PAYMENT_CALLBACK_URL=http://localhost:3000/api/payments

# -----------------------------------------------------------------------------
# External Notification Webhooks (Optional)
# -----------------------------------------------------------------------------
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
